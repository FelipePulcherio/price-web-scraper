{
  "name": "backend",
  "version": "0.0.1",
  "description": "Scrape pre defined websites in search for a product price and store data in MongoDB",
  "exports": "./dist/app.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "vercel-build": "tsc",
    "render-build": "npm install && tsc",
    "build": "tsc --watch",
    "build2": "tsc",
    "start": "nodemon ./dist/app.js",
    "start2": "node ./dist/app.js",
    "render-start": "node ./dist/app.js",
    "dev": "concurrently \"npm run build\" \"npm run start\" ",
    "dev2": "npm run build2 && npm run start2"
  },
  "keywords": [
    "Web",
    "Scraping",
    "Scraper",
    "Price"
  ],
  "author": "Felipe S. Pulcherio",
  "license": "ISC",
  "dependencies": {
    "@hokify/agenda": "^6.3.0",
    "@prisma/client": "^6.3.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.8.2",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-jwt": "^8.5.1",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "p-queue": "^9.0.0",
    "puppeteer-core": "^23.6.1",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "prisma": "^6.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "schema": "src/database/schema.prisma"
  }
}
